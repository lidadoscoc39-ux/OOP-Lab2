<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="321" Width="344">
    <Grid Margin="0,0,10,3">
        <Label Content="Введіть x:" HorizontalAlignment="Left" Margin="65,66,0,0" VerticalAlignment="Top"/>
        <Label Content="Введіть y:" HorizontalAlignment="Left" Margin="65,110,0,0" VerticalAlignment="Top"/>
        <Label Content="Введіть z:" HorizontalAlignment="Left" Margin="65,157,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="x" HorizontalAlignment="Left" Margin="145,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="y" HorizontalAlignment="Left" Margin="145,114,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="z" HorizontalAlignment="Left" Margin="145,161,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Button Content="Обчислити" HorizontalAlignment="Left" Margin="136,208,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Label Content="Результат s:" HorizontalAlignment="Left" Margin="65,241,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="s" HorizontalAlignment="Left" Margin="145,246,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Обчислення значення s" HorizontalAlignment="Left" Margin="98,22,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
    </Grid>
</Window>
