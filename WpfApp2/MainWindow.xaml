<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Розв'язання квадратного рівняння" Height="349" Width="336">
    <Grid Margin="0,0,0,-6">
        <Label Content="Розв'язання квадратного рівняння" HorizontalAlignment="Center" Margin="0,22,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="labelA" Content="Введіть a:" HorizontalAlignment="Left" Margin="45,69,0,0" VerticalAlignment="Top"/>
        <Label x:Name="labelB" Content="Введіть b:" HorizontalAlignment="Left" Margin="45,116,0,0" VerticalAlignment="Top"/>
        <Label x:Name="labelC" Content="Введіть c:" HorizontalAlignment="Left" Margin="45,166,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="a" HorizontalAlignment="Left" Margin="149,73,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="c" HorizontalAlignment="Left" Margin="149,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="b" HorizontalAlignment="Left" Margin="149,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Content="Обчислити" HorizontalAlignment="Left" Margin="128,207,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Label x:Name="labelD" Content="Дискримінант" HorizontalAlignment="Left" Margin="45,242,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="d" HorizontalAlignment="Left" Margin="149,246,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
        <Label x:Name="labelX1" Content="x1:" HorizontalAlignment="Left" Margin="64,284,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="x1" HorizontalAlignment="Left" Margin="95,288,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="56" IsReadOnly="True"/>
        <Label x:Name="labelX2" Content="x2:" HorizontalAlignment="Left" Margin="168,283,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="x2" HorizontalAlignment="Left" Margin="201,288,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54" IsReadOnly="True"/>
    </Grid>
</Window>